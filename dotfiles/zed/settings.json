  "load_direnv": "shell_hook",
  "lsp": {
    "python-lsp-server": {
      "settings": {
        "python": {
          "analysis": {
            "diagnosticMode": "workspace",
            "typeCheckingMode": "strict",
          },
        },
      },
    },
    "rust-analyzer": {
      "enable_lsp_tasks": true,
      "initialization_options": {
        "inlayHints": {
          "closureReturnTypeHints": {
            "enable": "always",
          },
          "lifetimeElisionHints": {
            "enable": "skip_trivial",
            "useParameterNames": true,
          },
          "maxLength": null,
        },
      },
    },
  },
  "show_whitespaces": "all",
